# Backend environment — copy to backend/.env (never commit .env)

# Database — full URL (async driver) or SUPABASE_DB_* parts
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Required — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# CORS (comma-separated, no spaces) — dev default covers Vite on :3000
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Redis — optional in dev (rate limiting falls back to in-memory)
# REDIS_URL=redis://localhost:6379/0

# Media storage — "auto", "local" (UPLOAD_DIR), "supabase", or "s3"
STORAGE_BACKEND=local
# UPLOAD_DIR=uploads
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=
