# AiROS VA media server — environment template. Copy to .env and fill in.
# Never commit .env.

# Control-API credentials — set the SAME values in the AiROS backend:
#   GO2RTC_API_AUTH=<GO2RTC_API_USER>:<GO2RTC_API_PASSWORD>
#   MEDIAMTX_API_AUTH=<MTX_API_USER>:<MTX_API_PASSWORD>
GO2RTC_API_USER=airos
GO2RTC_API_PASSWORD=change-me-long-random
MTX_API_USER=airos
MTX_API_PASSWORD=change-me-long-random

# Public host/IP browsers use for WebRTC ICE candidates (public IP, DNS
# name, or comma-separated list). UDP 8189 must be reachable, else ICE
# falls back to TCP/8889.
PUBLIC_MEDIA_HOST=media.example.com
